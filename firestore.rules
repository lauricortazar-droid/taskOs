rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidTask(data) {
      return data.keys().hasAll(['userId', 'tarea', 'estado', 'fechaIngreso']) &&
             data.keys().hasOnly(['userId', 'tarea', 'estado', 'fechaIngreso', 'fechaLimite', 'dominio', 'etiquetas', 'notas', 'solicitante', 'telefono', 'contacto', 'id', 'createdAt', 'updatedAt']) &&
             data.userId is string && data.userId == request.auth.uid &&
             data.tarea is string && data.tarea.size() > 0 && data.tarea.size() <= 1000 &&
             data.estado is string && data.estado in ['Pendiente', 'En Proceso', 'Completada'] &&
             data.fechaIngreso is string && data.fechaIngreso.size() <= 30 &&
             (!('fechaLimite' in data) || (data.fechaLimite is string && data.fechaLimite.size() <= 30)) &&
             (!('dominio' in data) || (data.dominio is string && data.dominio.size() <= 100)) &&
             (!('notas' in data) || (data.notas is string && data.notas.size() <= 5000)) &&
             (!('solicitante' in data) || (data.solicitante is string && data.solicitante.size() <= 150)) &&
             (!('telefono' in data) || (data.telefono is string && data.telefono.size() <= 50)) &&
             (!('etiquetas' in data) || (data.etiquetas is list && data.etiquetas.size() <= 20));
    }

    function isValidProfile(data) {
      return data.keys().hasAll(['userId']) &&
             data.keys().hasOnly(['userId', 'email', 'displayName', 'esencialTaskId', 'secundariasTaskIds', 'updatedAt']) &&
             data.userId is string && data.userId == request.auth.uid &&
             (!('email' in data) || (data.email is string && data.email.size() <= 200)) &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100));
    }

    match /users/{userId} {
      allow get: if isOwner(userId);

      match /profile/info {
        allow get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidProfile(incoming());
        allow update: if isOwner(userId) && isValidId(userId) && isValidProfile(incoming()) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId);
      }

      match /tasks/{taskId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(taskId) && isValidTask(incoming());
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(taskId) && isValidTask(incoming()) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(taskId);
      }
    }
  }
}
